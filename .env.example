# Upstash Redis REST credentials. The Vercel Marketplace Upstash integration
# sets these automatically. Either naming scheme works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: allows DELETE /api/preferences (wipe all data) when storage is Redis.
# Send it as the x-reset-token header. Without it, wiping is only allowed on the in-memory store.
RESET_TOKEN=
