# Supabase (server-only). Project Settings -> API Keys. The Vercel Supabase integration
# sets SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=   # new-style sb_secret_... key; used if SUPABASE_SERVICE_ROLE_KEY is empty

# Optional: allows DELETE /api/preferences (wipe all data) on Supabase.
# Send it as the x-reset-token header. Without it, wiping is only allowed on the in-memory store.
RESET_TOKEN=
