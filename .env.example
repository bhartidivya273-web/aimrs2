# Supabase (server-only). Project Settings -> API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=           # new-style sb_secret_... key (preferred)
# SUPABASE_SERVICE_ROLE_KEY=   # legacy service_role JWT; used only if SUPABASE_SECRET_KEY is empty

# Optional: allows DELETE /api/preferences (wipe all data) on Supabase.
# Send it as the x-reset-token header. Without it, wiping is only allowed on the in-memory store.
RESET_TOKEN=
